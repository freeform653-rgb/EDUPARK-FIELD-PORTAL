# Edupark Field Portal Environment Configuration Example
# Copy this file to .env and fill in your Supabase project credentials.
# If these variables are left empty, the application will automatically run
# in Local/Offline Mode with complete data persistence and full features.

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Initial Admin Credentials (used for local authentication fallback)
VITE_ADMIN_DEFAULT_USERNAME=admin
VITE_ADMIN_DEFAULT_PASSWORD=edupark@admin2025
